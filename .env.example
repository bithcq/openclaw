# OpenClaw 定制版环境变量模板
#
# 快速开始：
# 1) 复制本文件为 .env（源码目录本地运行），或 ~/.openclaw/.env（systemd 守护进程）
# 2) 只填你用到的值，其余保持注释即可
# 3) 不要把真实密钥提交到 git
#
# 说明：
# 模型 provider、API 密钥、网关模式等参数由 openclaw onboard 向导写入 openclaw.json，
# 不需要在这里重复配置。本文件只放向导不涉及的参数（网关 token、企微通道、代理等）。

# -----------------------------------------------------------------------------
# 网关认证
# -----------------------------------------------------------------------------
# 网关绑定到局域网时建议设置，用 openssl rand -hex 32 生成
OPENCLAW_GATEWAY_TOKEN=change-me-to-a-long-random-token

# -----------------------------------------------------------------------------
# 企业微信（WeCom）— 定制版核心通道
# -----------------------------------------------------------------------------
WECOM_CORP_ID=wwxxxx                                           # 企业 ID
WECOM_AGENT_ID=1000002                                         # 自建应用 AgentId
WECOM_SECRET=xxxxxxxx                                          # 应用 Secret
WECOM_TOKEN=xxxxxxxx                                           # 回调 Token
WECOM_AES_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx       # 回调 EncodingAESKey（43 位）
WECOM_CALLBACK_PATH=/api/wecom/callback                        # 回调路径

# 可选：出站代理（无固定公网 IP 时使用，企微要求调用来源 IP 在可信白名单内）
# WECOM_PROXY_URL=http://user:pass@host:3128

# 可选：消息接收人，@all 表示全员
# WECOM_MESSAGE_TOUSER=@all

# 可选：豆包语音识别（火山引擎 ASR，用于企微语音消息转文字）
# WECOM_DOUBAO_ASR_APP_ID=your-app-id
# WECOM_DOUBAO_ASR_TOKEN=your-token
# WECOM_DOUBAO_ASR_CLUSTER=volcengine_streaming_common
